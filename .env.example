# ==============================================================================
# Universal Intelligence Engine (UIE) - Environment Variables Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Universal Intelligence Engine (UIE)"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in Docker / Supabase / SQLite for local)
DATABASE_URL="sqlite+aiosqlite:///./uie.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://uie_user:uie_secure_password@postgres:5432/uie_db"

# Redis Queue & Cache
REDIS_URL="redis://localhost:6379/0"

# Search Layer (Self-Hosted SearXNG)
SEARXNG_URL="http://localhost:8080"

# AI Research Planner & Report Provider
# Options: 'heuristic' (zero-cost, offline), 'openai', 'anthropic', 'ollama'
AI_PROVIDER="heuristic"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Public API Tokens (Optional)
GITHUB_TOKEN=""

# Privacy & Compliance
DATA_RETENTION_DAYS=30
MAX_WORKER_TIMEOUT_SECONDS=60
MAX_RESULT_SIZE=500

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
